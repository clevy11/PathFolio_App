# Pathfolio Environment Variables
# Copy this file to .env and fill in your values

# Database (Vercel Postgres store 'fullstack')
# Connection string from Vercel dashboard
DATABASE_URL="postgres://user:password@your-host.example.com/pathfolio?sslmode=require"

# OpenRouter API Key (for LLM calls)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: override the default model (must be one your account can use).
# Default is a free-tier model with an automatic fallback chain.
# OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# Email (Nodemailer / Gmail API)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Pathfolio <your-email@gmail.com>"

# Playwright (local-only form filling)
# Set to 'true' to enable Playwright locally; disabled on Vercel
ENABLE_PLAYWRIGHT="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"